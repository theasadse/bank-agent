# ==============================================================================
# Bank SOC & AI Assistant Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Ollama Configuration (100% Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Groq Cloud API Configuration (Free High-Speed Cloud Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Google Gemini Free API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
